Algoritmo Salario
	definir numeroHoras,valorHora,salarioPagar Como Real
	
	escribir "Ingrese el número de horas laboradas"
	leer numeroHoras
	
	escribir "Ingrese el valor a pagar por cada hora"
	leer valorHora
	
	salarioPagar = numeroHoras * valorHora
	
	escribir "El salario a pagar es:" , salarioPagar
	
	
	
FinAlgoritmo
