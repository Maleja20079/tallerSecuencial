Algoritmo UsoFunciones
	definir num,seno,coseno,tangente,raiz1,lognatural,log10 Como Real
	
	escribir "Por favor ingrese un número"
	leer num
	seno = sen(num)
	coseno = cos(num)
	tangente = tan(num)
	raiz1 = rc(num)
	lognatural = LN(num)
	log10 = LN(num)/LN(10)
	
	
	escribir "EL SENO ES: ", seno
	escribir "EL COSENO ES: ", coseno
	escribir "LA TANGENTE ES: ", tangente
	escribir "LA RAIZ CUADRADA ES: ", raiz1
	escribir "EL LOGARITMO NATURAL ES: ", lognatural
	escribir "EL LOGARITMO EN BASE 10 ES: ", log10
	
	
	
	
	
	
	
	
	
FinAlgoritmo
