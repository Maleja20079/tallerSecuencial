Algoritmo numAleatorio
	
	definir numAleatori,aumento,porcentaje Como Real
	
	numAleatori = Aleatorio (0,200)
	porcentaje = numAleatori * 0.30
	aumento = numAleatori + porcentaje
	
	
	Escribir "El número Aleatorio es: ", numAleatori
	Escribir "Su aumento en un 30% es de: ", aumento
	
FinAlgoritmo
