Algoritmo conversion
	Definir cm,yardas,pies,pulgadas Como Real
	
	escribir "Ingrese el número en cm a convertir"
	leer cm
	
	yardas = cm / 91.44
	pies = cm / 30.48
	pulgadas = cm / 2.54
	
	escribir cm, " cm son: ", yardas , " yardas"
	escribir cm, " cm son: ", pies , " pies"
	escribir cm, " cm son: ", pulgadas , " pulgadas"
	
	
	
	
FinAlgoritmo
